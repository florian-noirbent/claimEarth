[gd_scene format=3]

[ext_resource type="Script" path="res://src/app/statistics_section.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/ui/statistics_stat_tile.tscn" id="2_tile"]
[ext_resource type="PackedScene" path="res://scenes/ui/statistics_icon_cell.tscn" id="3_cell"]
[ext_resource type="PackedScene" path="res://scenes/ui/statistics_bar_row.tscn" id="4_row"]

[sub_resource type="StyleBoxLine" id="StyleBox_separator"]
color = Color(0.38, 0.2, 0.1, 1)
thickness = 2

[node name="StatisticsSection" type="VBoxContainer"]
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 8
script = ExtResource("1_script")
stat_tile_scene = ExtResource("2_tile")
icon_cell_scene = ExtResource("3_cell")
bar_row_scene = ExtResource("4_row")

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="Icon" type="TextureRect" parent="Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(28, 28)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="Title" type="Label" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
theme_override_colors/font_color = Color(0.96, 0.75, 0.19, 1)
theme_override_colors/font_shadow_color = Color(0.02, 0.015, 0.01, 1)
theme_override_constants/shadow_offset_x = 2
theme_override_constants/shadow_offset_y = 2
theme_override_font_sizes/font_size = 21
text = "Section"

[node name="Subtitle" type="Label" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
mouse_filter = 2
theme_override_colors/font_color = Color(0.75, 0.78, 0.83, 1)
theme_override_font_sizes/font_size = 15
horizontal_alignment = 2
text_overrun_behavior = 3

[node name="Separator" type="HSeparator" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 4
theme_override_styles/separator = SubResource("StyleBox_separator")

[node name="Tiles" type="GridContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 12
columns = 4

[node name="IconGrid" type="HFlowContainer" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
mouse_filter = 2
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10

[node name="Bars" type="VBoxContainer" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6
