[ext_resource type="Texture2D" path="res://assets/ui/statistics/death.svg" id="10_death"]
[ext_resource type="Texture2D" path="res://assets/ui/statistics/items.svg" id="11_items"]
[ext_resource type="Texture2D" path="res://assets/objects/perk.png" id="12_perk"]
[ext_resource type="Texture2D" path="res://assets/ui/statistics/unknown.svg" id="13_unknown"]
[ext_resource type="Texture2D" path="res://assets/ui/hazard_lava.svg" id="14_lava"]
[ext_resource type="Texture2D" path="res://assets/ui/hazard_suffocation.svg" id="15_suffocation"]
[ext_resource type="Texture2D" path="res://assets/ui/hazard_acid.svg" id="16_acid"]
[ext_resource type="Texture2D" path="res://assets/ui/hazard_poison.svg" id="17_poison"]
[ext_resource type="Texture2D" path="res://assets/objects/large_bomb.svg" id="18_bomb"]
[ext_resource type="Texture2D" path="res://assets/ui/hazard_impact.svg" id="19_impact"]
[ext_resource type="Texture2D" path="res://assets/ui/statistics/bounds.svg" id="20_bounds"]
